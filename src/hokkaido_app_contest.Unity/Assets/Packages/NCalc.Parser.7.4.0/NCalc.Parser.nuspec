<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>NCalc.Parser</id>
    <version>7.4.0</version>
    <authors>Sebastien Ros and contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>NCalc.png</icon>
    <description>Default Parlot-based parser for NCalc expressions, including parser options and argument separator configuration.</description>
    <copyright>Sebastien Ros and contributors</copyright>
    <repository type="git" url="https://github.com/ncalc/ncalc.git" commit="2bd3e4981ac092c0b69ca18af866cd7f3f5b207b" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="NCalc.Domain" version="7.4.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="NCalc.Domain" version="7.4.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="NCalc.Domain" version="7.4.0" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>